// Conceptual joint-drive assembly, dimensions in millimetres.
// An illustrative design for Assembly Lab. Uses no UR10e internal drawings.
// A separate solid part can be generated by changing the part parameter.
part = "assembly"; // [assembly, motor, gearbox, wiring]
separation = 0; // [0:0.05:1]
$fn = 64;

module gear_outline(teeth, root, tip) {
    polygon([for (n = [0 : 4*teeth-1])
        let(a = n*360/(4*teeth), r = n%4 == 1 || n%4 == 2 ? tip : root)
        [r*cos(a),r*sin(a)]]);
}
module annulus(outer, inner, height) {
    difference() {
        cylinder(r=outer,h=height);
        translate([0,0,-1]) cylinder(r=inner,h=height+2);
    }
}
module gear(teeth, tip, bore, depth) {
    linear_extrude(depth) difference() {
        gear_outline(teeth,0.86*tip,tip);
        circle(r=bore);
    }
}
module motor() {
    color("#313e4a") translate([0,0,-27]) cylinder(r=28,h=57,center=true);
    color("#c5d3dc") translate([0,0,-13]) cylinder(r=8.2,h=102,center=true);
    color("#8198a6") for (z=[-56,1]) translate([0,0,z]) annulus(58,18,5);
    for (angle=[0:30:330]) rotate([0,0,angle]) {
        color("#313e4a") translate([44,0,-24]) cube([9,19,51],center=true);
        color("#df793e") for (z=[-48,-34,-20,-6])
            translate([44,0,z]) rotate_extrude()
                translate([9,0]) circle(r=2.1,$fn=20);
    }
}
module gearbox() {
    color("#8198a6") translate([0,0,8]) linear_extrude(23) difference() {
        circle(r=62);
        gear_outline(46,50,53);
    }
    color("#b08854") translate([0,0,10]) gear(14,18.4,6.5,18);
    for (angle=[30:120:270]) rotate([0,0,angle]) translate([34.5,0,0]) {
        color("#c5d3dc") translate([0,0,10]) gear(16,20.7,4.5,18);
        color("#313e4a") translate([0,0,19]) cylinder(r=4.4,h=26,center=true);
    }
}
module lead(points) {
    for (k = [0:len(points)-2]) hull() {
        translate(points[k]) sphere(r=1.65,$fn=16);
        translate(points[k+1]) sphere(r=1.65,$fn=16);
    }
}
module wiring() {
    colors=["#e97a59","#eec36a","#50bec8","#80a5f3"];
    for (i=[0:3]) color(colors[i]) translate([(i-1.5)*3.8,0,0])
        lead([[35,-50,-50],[58,-52,-37],[74,-15,-8],[71,29,9],[52,62,33],[23,65,35]]);
    color("#243745") {
        translate([33,-53,-52]) cube([23,16,14],center=true);
        translate([21,64,36]) cube([25,16,14],center=true);
        translate([72,18,8]) rotate([75,0,-8]) cylinder(r=11,h=9,center=true);
    }
}
if (part=="assembly" || part=="motor") translate([0,0,-46*separation]) motor();
if (part=="assembly" || part=="gearbox") translate([0,0,82*separation]) gearbox();
if (part=="assembly" || part=="wiring") translate([75*separation,0,0]) wiring();
